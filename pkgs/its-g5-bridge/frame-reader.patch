-            payload = bytes(self._buf[HEADER_LEN: HEADER_LEN + plen])
-            del self._buf[: HEADER_LEN + plen]
+            off = HEADER_LEN + self._hdr_extra
+            payload = bytes(self._buf[off: off + plen])
+            if self._hdr_extra == 0 and len(self._buf) >= HEADER_LEN + 1 + plen:
+                shifted = bytes(self._buf[HEADER_LEN + 1: HEADER_LEN + 1 + plen])
+                # ITS-G5 only carries 802.11 data frames, so a payload opening
+                # with NUL is an RSSI byte, not the frame: that also decides the
+                # synthetic boot frame, which never parses as 802.11 at all.
+                if (not _looks_80211(payload) and _looks_80211(shifted)) or (
+                    payload[:1] == b"\x00" and shifted[:1] != b"\x00"
+                ):
+                    self._hdr_extra = 1
+                    payload = shifted
+                    off += 1
+            del self._buf[: off + plen]
             yield sec, usec, payload
 
 
