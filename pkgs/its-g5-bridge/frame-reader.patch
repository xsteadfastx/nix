 # Frame parser
 # ---------------------------------------------------------------------------
 
+def _looks_80211(b: bytes) -> bool:
+    """Cheap sanity check: 802.11 data frame with a broadcast addr1/addr2."""
+    return (
+        len(b) > 12
+        and (b[0] & 0x03) == 0
+        and ((b[0] >> 2) & 0x03) == 2
+        and b[4:10] == b"\xff" * 6
+    )
+
+
 class FrameReader:
-    """Stateful resync parser: scans a byte stream for ITS5 frames."""
+    """Stateful resync parser: scans a byte stream for ITS5 frames.
+
+    Some firmware (e.g. 0.2.5) puts an RSSI byte between the length field and
+    the 802.11 frame, some don't. The stream format is otherwise identical, so
+    the extra byte is detected once from the first frame that actually parses
+    as 802.11 and is then applied to every following frame — otherwise the
+    payload is shifted by one byte and its last byte is left in the buffer.
+    """
     def __init__(self):
         self._buf = bytearray()
+        self._hdr_extra = 0
 
     def feed(self, chunk: bytes):
         self._buf.extend(chunk)
