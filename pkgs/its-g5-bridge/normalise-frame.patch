 # Frame decoding
 # ---------------------------------------------------------------------------
 
+def normalise_frame(payload: bytes) -> bytes:
+    """Drop a leading (RSSI) byte when the frame only parses one byte in."""
+    def ok(b: bytes) -> bool:
+        return (
+            len(b) > 12
+            and (b[0] & 0x03) == 0
+            and ((b[0] >> 2) & 0x03) == 2
+            and b[4:10] == b"\xff" * 6
+        )
+
+    if not ok(payload) and ok(payload[1:]):
+        return payload[1:]
+    return payload
+
